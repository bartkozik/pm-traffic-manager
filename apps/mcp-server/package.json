{
  "name": "@ptm/mcp-server",
  "private": true,
  "version": "1.0.0",
  "description": "MCP server for PM Traffic Management planning board operations",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@ptm/contracts": "workspace:*",
    "@ptm/domain": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.3",
    "typescript": "~5.6.2",
    "vitest": "^3.0.7"
  }
}
