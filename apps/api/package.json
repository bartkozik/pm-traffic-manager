{
  "name": "@ptm/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx src/main.ts",
    "dev:watch": "dotenv -e ../../.env -- tsx watch --ignore ../../node_modules --ignore node_modules src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/main.cjs",
    "start": "node dist/main.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@node-saml/node-saml": "5.1.0",
    "@ptm/contracts": "workspace:*",
    "@ptm/domain": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.3",
    "typescript": "~5.6.2",
    "vitest": "^3.0.7"
  }
}
