# Local development only. No production credentials or provider keys are included.
VITE_PTM_API_URL=http://127.0.0.1:4000
VITE_PTM_AUTH_ENABLED=false
VITE_PTM_SYNC_HOST=127.0.0.1
VITE_PTM_SYNC_WS_PORT=1234
VITE_PTM_SYNC_HTTP_PORT=1235
PTM_API_HOST=127.0.0.1
PTM_API_PORT=4000
PTM_API_CORS_ORIGIN=http://127.0.0.1:5173
POSTGRES_PORT=55432
PTM_DATABASE_URL=postgres://ptm_local:local-development-only@127.0.0.1:55432/ptm_local
PTM_AUTH_ENABLED=false
PTM_WORKSPACE_DOMAIN=example.test
INTERFACE=127.0.0.1
WS_PORT=1234
HTTP_PORT=1235
YJS_DATA_DIR=./data-docs
LOG_LEVEL=info

# Enable SAML only with your own local/test identity provider and credentials.
# The application retains its original auth/access logic; these settings are optional.
# PTM_ALLOWED_EMAILS=admin-1@example.test
# PTM_AUTH_SESSION_SECRET=
# PTM_AUTH_SERVICE_TOKEN=
# PTM_SAML_ACS_URL=http://127.0.0.1:4000/api/auth/saml/acs
# PTM_SAML_METADATA_URL=http://127.0.0.1:4000/api/auth/saml/metadata.xml
# PTM_SAML_SP_ENTITY_ID=
# PTM_SAML_IDP_ENTITY_ID=
# PTM_SAML_IDP_SSO_URL=
# PTM_SAML_IDP_CERTIFICATE=
# PTM_SAML_SP_PRIVATE_KEY=
# PTM_SAML_SP_CERTIFICATE=

# AI providers are opt-in. Leave credentials unset for local verification.
# PTM_OPENAI_API_KEY=
# PTM_ANTHROPIC_API_KEY=

PTM_DEMO_ENABLED=false
VITE_PTM_DEMO_ENABLED=false
PTM_DEMO_OPENAI_API_KEY=
